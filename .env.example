# Copie para `.env.local` e preencha. Nada aqui é segredo: a config web do Firebase
# vai para o navegador de qualquer forma. A segurança está em `firestore.rules`.

# Nome exibido no site e na aba do navegador.
VITE_CLUB_NAME="Clube do Livro"

# Firebase → Configurações do projeto → Seus apps → App da Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional. Sem chave, a busca usa a cota compartilhada do Google Books (que costuma
# esgotar) e cai para o Open Library. Restrinja a chave ao domínio do site.
VITE_GOOGLE_BOOKS_API_KEY=

# Opcional. Chave de site do reCAPTCHA v3: liga o Firebase App Check, que impede
# scripts fora do site de usarem o seu projeto Firebase.
VITE_APPCHECK_SITE_KEY=

# Para testar sem Firebase, use `npm run dev:demo` (lê `.env.demo`).

# Opcional. Confere indicações repetidas com o Gemini, pelo Firebase AI Logic
# (sem chave do Gemini no site). Sem isto, a conferência passa direto.
VITE_AI_MODEL=
