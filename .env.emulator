# `npm run dev:emulator`: o site com login, banco e regras dos emuladores do Firebase,
# na sua máquina. Não toca no projeto real nem gasta cota. Os dados ficam em
# `.emulator-data/`; apague a pasta para começar do zero.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=emulador
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-clube-do-livro
VITE_FIREBASE_APP_ID=emulador
