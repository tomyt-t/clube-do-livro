rules_version = '2';

// Security model
// --------------
// * Only verified emails present in /allowlist can read or write anything,
//   and only from the account that first claimed that entry (its seat): a
//   second account for the same email would otherwise vote twice.
// * Member data is bound to request.auth.uid and is create-only: answers,
//   nominations and ballot receipts can never be edited or deleted, so nobody
//   (including the admin) can change what another member sent. The one
//   exception: a nomination the organizer lets go (two members nominated the
//   same reading) leaves the list, and only its nominator may answer again.
// * Votes are anonymous: a ballot is one batch that creates an empty receipt
//   (who voted), bumps the cycle's ballot count and adds +1 to the chosen
//   books in a tally (every choice to `votes`, the first one also to
//   `firsts`) that nobody can read until voting closes. Nothing links a
//   member to their choices.
// * Admin writes follow a state machine and cannot touch the tally; the
//   declared winner must follow the club's rule (most votes, then most first
//   choices, then a draw among the books still tied). A draw is a
//   pseudo-random number started from the time voting closed, so these rules
//   recompute it.
// * The cycle moves on by itself: any member may take the next step once
//   everyone (settings/club.members) has answered, voted or finished the
//   book. The organizer may take a step at any time.
// * Everything not explicitly allowed is denied.
//
// Limits shared with src/domain: book fields (book.ts), two choices per
// ballot and 16 options (voting.ts). Rules have no loops, so list checks are
// unrolled, each slot guarded by the list's size.
//
// Firestore evaluates at most 1000 expressions per request, shared by every
// document of a batch. Hence the order below: cheap status checks first, and
// list checks that only do real work for the options that exist.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity

    function email() {
      return request.auth.token.email.lower();
    }

    function allowlistEntry() {
      return /databases/$(database)/documents/allowlist/$(email());
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The seat is the account that first used the entry (see claimsSeat). A
    // missing entry fails the read, which denies the request.
    function isMember() {
      return isVerified() && get(allowlistEntry()).data.get('uid', '') == request.auth.uid;
    }

    function isAdmin() {
      return isMember() && get(allowlistEntry()).data.get('admin', false) == true;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    // ------------------------------------------------------------------ paths

    function cyclePath(c) {
      return /databases/$(database)/documents/cycles/$(c);
    }

    function nominationPath(c, n) {
      return /databases/$(database)/documents/cycles/$(c)/nominations/$(n);
    }

    function answerPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/answers/$(request.auth.uid);
    }

    function titlePath(c, key) {
      return /databases/$(database)/documents/cycles/$(c)/titles/$(key);
    }

    function tallyPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/tally/counts;
    }

    function receiptPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/receipts/$(request.auth.uid);
    }

    function readerPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/readers/$(request.auth.uid);
    }

    function settingsPath() {
      return /databases/$(database)/documents/settings/club;
    }

    // Cycles are named by number, so a round can only ever be opened once.
    function cycleIdFor(number) {
      return 'ciclo-' + string(number);
    }

    // How many members "everyone" is. Missing settings stop the automatic
    // flow (the read fails) until the organizer sets them.
    function everyone(count) {
      return count >= get(settingsPath()).data.members;
    }

    // ------------------------------------------------------------- validation

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Links are stored URL-encoded (printable ASCII, no spaces).
    function isLink(value) {
      return value is string && value.size() <= 1000 && value.matches('https://[!-~]+');
    }

    function isUploadedCover(value) {
      return value is string && value.size() <= 200000
        && value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+=*');
    }

    function isOptionalTime(value) {
      return value == null || value is timestamp;
    }

    // Any kind of reading, described in free text: only sizes and link
    // formats are checked.
    function isSynopsis(book) {
      return (book.synopsis == null && book.synopsisSource == null)
        || (isText(book.synopsis, 1, 2000)
          && (book.synopsisSource == null
            || book.synopsisSource in ['wikipedia', 'open-library', 'google-books', 'anilist']));
    }

    function isBook(book) {
      return book is map
        && hasExactly(book, ['title', 'synopsis', 'synopsisSource', 'synopsisUrl', 'coverUrl'])
        && isText(book.title, 1, 200)
        && isSynopsis(book)
        && (book.synopsisUrl == null || isLink(book.synopsisUrl))
        && (book.coverUrl == null || isLink(book.coverUrl) || isUploadedCover(book.coverUrl));
    }

    function isBeforeDeadline(deadline) {
      return deadline == null || request.time < deadline;
    }

    // -------------------------------------------------------------- allowlist
    // Document id = lowercase email. Members can only check their own entry
    // and claim its seat, once; only the admin can list or change entries,
    // never their own. The admin may free a seat (drop its account), never
    // bind one to an account.

    match /allowlist/{address} {
      allow get: if isVerified() && address == email();
      allow list: if isAdmin();
      allow create: if isAdmin() && address != email()
        && address == address.lower()
        && address.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.keys().hasOnly(['admin'])
        && request.resource.data.get('admin', false) is bool;
      // The organizer may change only the admin flag (a stale "add" of an
      // existing email fails instead of freeing its seat). Freeing a seat is
      // removing the email and adding it again.
      allow update: if claimsSeat(address)
        || (isAdmin() && address != email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin'])
          && request.resource.data.get('admin', false) is bool);
      allow delete: if isAdmin() && address != email();
    }

    function claimsSeat(address) {
      return isVerified() && address == email()
        && !('uid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- members
    // Public profile inside the club: name and photo only, never the email.

    match /members/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && isSelf(uid)
        && hasExactly(request.resource.data, ['name', 'photoURL'])
        && isText(request.resource.data.name, 1, 80)
        && (request.resource.data.photoURL == null || isLink(request.resource.data.photoURL));
    }

    // --------------------------------------------------------------- settings
    // Only the member count, kept by the organizer in step with the allowlist.

    match /settings/{docId} {
      allow read: if isMember() && docId == 'club';
      allow create, update: if isAdmin() && docId == 'club'
        && hasExactly(request.resource.data, ['members'])
        && request.resource.data.members is int
        && request.resource.data.members >= 1
        && request.resource.data.members <= 100;
    }

    // ----------------------------------------------------------------- cycles

    match /cycles/{cycleId} {
      allow read: if isMember();
      allow create: if (isAdmin() && isNewCycle(cycleId, request.resource.data))
        || (isMember() && isNextRound(cycleId, request.resource.data));
      allow update: if isMember()
        && (countsOwnPart(cycleId, resource.data, request.resource.data)
          || isFlowStep(cycleId, resource.data, request.resource.data)
          || (isAdmin() && isValidTransition(cycleId, resource.data, request.resource.data)));
      // A cycle can be dropped only before anyone answered: its answers and
      // titles would outlive it and lock members out of a new one.
      allow delete: if isAdmin() && resource.data.status == 'nominating'
        && resource.data.responses == 0 && resource.data.nominationIds.size() == 0
        && resource.data.letGo.size() == 0;

      // ---------------------------------------------------------- answers
      // One per member and final: either a nomination id or null (passed).
      // Replaced only by its member, once the organizer let its nomination go.

      match /answers/{uid} {
        allow get: if isMember()
          && (isSelf(uid) || (isAdmin() && isFlagged(cycleId, resource.data.nominationId)));
        allow create, update: if isMember() && isSelf(uid) && isNewAnswer(cycleId);
      }

      // ------------------------------------------------------ nominations
      // Never stores who nominated. Created only together with the
      // nominator's own answer pointing at it. Hidden until the nomination
      // call is over: before that, each member reads only their own.

      match /nominations/{nominationId} {
        // A member whose nomination was let go sees the list (everyone saw it
        // during the review), to choose again knowing what is on it.
        allow get: if isMember()
          && (isRevealed(cycleId) || isOwnNomination(cycleId, nominationId) || isLetGo(cycleId));
        allow list: if isMember() && (isRevealed(cycleId) || isLetGo(cycleId));
        allow create: if isMember() && isNewNomination(cycleId, nominationId);
        // Let go by the organizer, together with its title record.
        allow delete: if isAdmin() && isUnlocking(cycleId, nominationId)
          && !existsAfter(titlePath(cycleId, resource.data.titleKey));
      }

      // ----------------------------------------------------------- titles
      // One per nominated title, by the key the app derives from it (case,
      // accents and punctuation removed), so the same reading cannot be
      // nominated twice. Anyone may check one title, to be told it is taken;
      // nobody may list them, which would reveal the hidden nominations.
      // Rules cannot normalize Unicode, so they check only the key's shape:
      // a doctored app could nominate a twin, which everyone sees later.

      match /titles/{key} {
        allow get: if isMember();
        allow create: if isMember() && isNewTitle(cycleId, key);
        allow delete: if isAdmin() && isReopening(cycleId) && isLetGoTitle(cycleId, key);
      }

      // ---------------------------------------------------------- ballots
      // A receipt says only *that* a member voted; the tally says only
      // *what* was voted.

      match /receipts/{uid} {
        allow get: if isMember() && isSelf(uid);
        allow create: if isMember() && isSelf(uid) && isNewReceipt(cycleId);
      }

      match /tally/{docId} {
        allow get: if isMember() && docId == 'counts'
          && !(get(cyclePath(cycleId)).data.status in ['nominating', 'voting']);
        allow create: if isMember() && docId == 'counts' && isNewTally(cycleId);
        allow update: if isMember() && docId == 'counts' && isValidVote(cycleId);
      }

      // ---------------------------------------------------------- readers
      // "Acabei de ler!": the mark says *that* a member finished; the cycle
      // only counts how many.

      match /readers/{uid} {
        allow get: if isMember() && isSelf(uid);
        allow create: if isMember() && isSelf(uid) && isNewReaderMark(cycleId);
      }
    }

    // ------------------------------------------------------ nomination writes
    // Batch: answers/{uid} + cycles/{id}.responses (+1) [+ nominations/{id}]

    // A member whose nomination was let go may answer again past the
    // deadline: the vote waits for them (see startsVoting).
    function acceptsNominations(c) {
      let cycle = get(cyclePath(c)).data;
      return cycle.status == 'nominating' && cycle.review == null
        && (isBeforeDeadline(cycle.nominationDeadline) || isLetGo(c));
    }

    // The member's answer is new in this batch, or replaces (with a new one)
    // one whose nomination the organizer let go.
    function isAnsweringNow(c) {
      return existsAfter(answerPath(c)) && (!exists(answerPath(c))
        || (isLetGo(c) && getAfter(answerPath(c)).data.nominationId
          != get(answerPath(c)).data.nominationId));
    }

    // Let-go nominations wait in the cycle's letGo list until their members
    // answer again.
    function isLetGo(c) {
      let before = get(answerPath(c)).data.nominationId;
      return before != null && before in get(cyclePath(c)).data.letGo;
    }

    // A member's own answer, ballot or "Acabei de ler!", counted on the cycle.
    function countsOwnPart(c, before, after) {
      return (before.status == 'nominating' && countsOwnAnswer(c, before, after))
        || (before.status == 'voting' && countsOwnBallot(c, before, after))
        || (before.status == 'reading' && countsOwnFinish(c, before, after));
    }

    // Answering again after a let-go also takes the old id off letGo.
    function countsOwnAnswer(c, before, after) {
      return changesOnly(['responses', 'nominationIds', 'letGo'])
        && after.responses == before.responses + 1
        && isAnsweringNow(c)
        && listsOwnNomination(c, before.nominationIds, after.nominationIds)
        && after.letGo == (exists(answerPath(c))
          ? before.letGo.removeAll([get(answerPath(c)).data.nominationId])
          : before.letGo);
    }

    // A nomination also joins the cycle's list, in arrival order, while the
    // ballot has room for it.
    function listsOwnNomination(c, before, after) {
      let nominated = getAfter(answerPath(c)).data.nominationId;
      return (nominated == null && after == before)
        || (nominated != null && before.size() < 16 && after == before.concat([nominated]));
    }

    function isNewAnswer(c) {
      let answer = request.resource.data;
      return acceptsNominations(c)
        && hasExactly(answer, ['nominationId'])
        && isAnsweringNow(c)
        && getAfter(cyclePath(c)).data.responses == get(cyclePath(c)).data.responses + 1
        && (answer.nominationId == null
          || (answer.nominationId is string
            && !exists(nominationPath(c, answer.nominationId))
            && existsAfter(nominationPath(c, answer.nominationId))));
    }

    // Ids are the app's random ones: a long id would not fit the field paths
    // the tally and results use, and the winner could never be declared.
    // It joins the list in the same batch, and never under a let-go id
    // (which would take over that member's chance to answer again).
    function isNewNomination(c, n) {
      let key = request.resource.data.titleKey;
      return n.matches('[A-Za-z0-9]{20}')
        && !(n in get(cyclePath(c)).data.letGo)
        && getAfter(cyclePath(c)).data.nominationIds
          == get(cyclePath(c)).data.nominationIds.concat([n])
        && acceptsNominations(c)
        && hasExactly(request.resource.data, ['book', 'titleKey'])
        && isBook(request.resource.data.book)
        && isTitleKey(key)
        && !exists(titlePath(c, key)) && existsAfter(titlePath(c, key))
        && isAnsweringNow(c)
        && getAfter(answerPath(c)).data.nominationId == n;
    }

    // Words of letters and digits, separated by single spaces (no slash).
    function isTitleKey(key) {
      return key is string && key.size() >= 1 && key.size() <= 200
        && key.matches('[^ /]+( [^ /]+)*');
    }

    // Created with the nomination that carries this key, in the same batch.
    function isNewTitle(c, key) {
      return request.resource.data.keys().size() == 0
        && isAnsweringNow(c)
        && getAfter(nominationPath(c, getAfter(answerPath(c)).data.nominationId))
          .data.titleKey == key;
    }

    // Revealed once everyone answered and the review began, or past nominations.
    function isRevealed(c) {
      let cycle = get(cyclePath(c)).data;
      return cycle.status != 'nominating' || cycle.review != null;
    }

    function isOwnNomination(c, n) {
      return get(answerPath(c)).data.nominationId == n;
    }

    // ------------------------------------------------------------ ballot writes
    // Batch: receipts/{uid} (empty) + cycles/{id}.ballots (+1) + tally

    function isVotingNow(c) {
      return !exists(receiptPath(c)) && existsAfter(receiptPath(c));
    }

    function isNewReceipt(c) {
      return request.resource.data.keys().size() == 0
        && getAfter(cyclePath(c)).data.ballots == get(cyclePath(c)).data.ballots + 1;
    }

    function countsOwnBallot(c, before, after) {
      return isBeforeDeadline(before.votingDeadline)
        && changesOnly(['ballots'])
        && after.ballots == before.ballots + 1
        && isVotingNow(c)
        && getAfter(tallyPath(c)).data != get(tallyPath(c)).data;
    }

    // The member's own nomination, or '' if they passed or never answered
    // (never a valid option id).
    function ownNomination(c) {
      let id = exists(answerPath(c)) ? get(answerPath(c)).data.nominationId : '';
      return id == null ? '' : id;
    }

    // Two choices (one if the member's nomination was merged), or fewer when
    // there are not enough eligible books.
    function requiredChoices(options, own, grouped) {
      let eligible = options.size() - (own in options ? 1 : 0);
      let most = grouped ? 1 : 2;
      return eligible < most ? eligible : most;
    }

    // Option i, if chosen, gains one vote, and its first-choice count either
    // stays or gains one. Options not chosen are left as they were (the
    // diff checks below).
    function addsOneAt(o, chosen, i) {
      let x = o[i];
      let before = resource.data;
      let after = request.resource.data;
      return !(x in chosen)
        || (after.votes[x] == before.votes[x] + 1
          && (after.firsts[x] == before.firsts[x] || after.firsts[x] == before.firsts[x] + 1));
    }

    function addsOneEach(o, s) {
      let n = o.size();
      return (n < 1 || addsOneAt(o, s, 0)) && (n < 2 || addsOneAt(o, s, 1))
        && (n < 3 || addsOneAt(o, s, 2)) && (n < 4 || addsOneAt(o, s, 3))
        && (n < 5 || addsOneAt(o, s, 4)) && (n < 6 || addsOneAt(o, s, 5))
        && (n < 7 || addsOneAt(o, s, 6)) && (n < 8 || addsOneAt(o, s, 7))
        && (n < 9 || addsOneAt(o, s, 8)) && (n < 10 || addsOneAt(o, s, 9))
        && (n < 11 || addsOneAt(o, s, 10)) && (n < 12 || addsOneAt(o, s, 11))
        && (n < 13 || addsOneAt(o, s, 12)) && (n < 14 || addsOneAt(o, s, 13))
        && (n < 15 || addsOneAt(o, s, 14)) && (n < 16 || addsOneAt(o, s, 15));
    }

    // The tally keeps exactly the ballot's options (it is created with them
    // and never gains or loses a key), so the changed keys are options.
    // A member whose nomination was merged: it already counts as their first
    // choice, on the ballot option it became.
    function isValidVote(c) {
      let cycle = get(cyclePath(c)).data;
      let votes = request.resource.data.votes.diff(resource.data.votes);
      let firsts = request.resource.data.firsts.diff(resource.data.firsts);
      let own = ownNomination(c);
      let mine = cycle.merged.get(own, own);
      let grouped = own in cycle.merged || cycle.merged.values().hasAny([own]);
      return cycle.status == 'voting'
        && hasExactly(request.resource.data, ['votes', 'firsts'])
        && votes.addedKeys().size() == 0 && votes.removedKeys().size() == 0
        && firsts.addedKeys().size() == 0 && firsts.removedKeys().size() == 0
        && votes.changedKeys().size() == requiredChoices(cycle.options, mine, grouped)
        && !(mine in votes.changedKeys())
        // One first choice among the books voted for; none if already counted.
        && (grouped
          ? firsts.changedKeys().size() == 0
          : firsts.changedKeys().size() == 1
            && firsts.changedKeys().difference(votes.changedKeys()).size() == 0)
        && addsOneEach(cycle.options, votes.changedKeys())
        && isVotingNow(c);
    }

    // -------------------------------------------------------- reader writes
    // Batch: readers/{uid} (empty) + cycles/{id}.finishedReaders (+1)

    function isFinishingNow(c) {
      return !exists(readerPath(c)) && existsAfter(readerPath(c));
    }

    function isNewReaderMark(c) {
      return request.resource.data.keys().size() == 0
        && get(cyclePath(c)).data.status == 'reading'
        && getAfter(cyclePath(c)).data.finishedReaders
          == get(cyclePath(c)).data.finishedReaders + 1;
    }

    function countsOwnFinish(c, before, after) {
      return changesOnly(['finishedReaders'])
        && after.finishedReaders == before.finishedReaders + 1
        && isFinishingNow(c);
    }

    // ------------------------------------------------------------- flow steps
    // Any member, once everyone has done their part. Declaring the winner is
    // fully checked, so anyone may do it as soon as the vote is closed.

    function isFlowStep(c, before, after) {
      return (before.status == 'nominating'
          && (startsReview(before, after)
            || recordsReview(before, after)
            // Deadlines are the organizer's: the automatic open sets none.
            || (isClearReview(before) && startsVoting(c, before, after)
              && after.votingDeadline == null)))
        || (before.status == 'voting'
          && (before.options.size() == 1 || everyone(before.ballots))
          && closesVoting(before, after))
        || (before.status == 'tallying' && declaresWinner(c, before, after))
        || (before.status == 'reading' && finishesForEveryone(before, after));
    }

    // Ending the book always opens the next round, in the same batch.
    function finishesForEveryone(before, after) {
      let next = cyclePath(cycleIdFor(before.number + 1));
      return finishesReading(before, after)
        && everyone(before.finishedReaders)
        && !exists(next) && existsAfter(next);
    }

    // The next round, created together with ending the book before it.
    function isNextRound(id, cycle) {
      let previous = cyclePath(cycleIdFor(cycle.number - 1));
      return isNewCycle(id, cycle)
        && cycle.nominationDeadline == null
        && get(previous).data.status == 'reading'
        && getAfter(previous).data.status == 'finished';
    }

    // ------------------------------------------------------------- admin: cycles

    function isNewCycle(id, cycle) {
      return hasExactly(cycle, ['number', 'status', 'responses', 'nominationIds',
                                'nominationDeadline', 'votingDeadline', 'createdAt',
                                'options', 'ballots', 'votingOpenedAt', 'votingClosedAt',
                                'results', 'winner', 'readingStartedAt', 'finishedReaders',
                                'finishedAt', 'review', 'merged', 'letGo', 'letGoAt',
                                'flagged'])
        && cycle.number is int && cycle.number >= 1
        && id == cycleIdFor(cycle.number)
        && cycle.status == 'nominating' && cycle.responses == 0
        && cycle.nominationIds == [] && cycle.finishedReaders == 0
        && isOptionalTime(cycle.nominationDeadline) && cycle.votingDeadline == null
        && cycle.createdAt == request.time
        && cycle.options == [] && cycle.ballots == 0
        && cycle.votingOpenedAt == null && cycle.votingClosedAt == null
        && cycle.results == null && cycle.winner == null
        && cycle.readingStartedAt == null && cycle.finishedAt == null
        && cycle.review == null && cycle.merged == {}
        && cycle.letGo == [] && cycle.letGoAt == null && cycle.flagged == [];
    }

    function editsDeadline(before, after) {
      return (before.status == 'nominating' && changesOnly(['nominationDeadline'])
          && isOptionalTime(after.nominationDeadline))
        || (before.status == 'voting' && changesOnly(['votingDeadline'])
          && isOptionalTime(after.votingDeadline));
    }

    function hasDistinctOptions(options) {
      return options is list && options.size() >= 1 && options.size() <= 16
        && options.toSet().size() == options.size();
    }

    // Batch: cycles/{id} (to voting, with the ballot's options) + tally (at
    // zero, merged readings ahead). The ballot is every nomination left after
    // merges, in arrival order, whoever opens the vote: nobody's nomination
    // can be left out. Members whose nominations were let go get three days
    // to answer again before anyone (the organizer included) can open it.
    function startsVoting(c, before, after) {
      return before.status == 'nominating' && after.status == 'voting'
        && (before.letGo.size() == 0 || request.time > before.letGoAt + duration.value(3, 'd'))
        && changesOnly(['status', 'options', 'ballots', 'votingOpenedAt', 'votingDeadline'])
        && hasDistinctOptions(after.options)
        && after.options == before.nominationIds.removeAll(before.merged.keys())
        && after.ballots == 0
        && after.votingOpenedAt == request.time
        && isOptionalTime(after.votingDeadline)
        && !exists(tallyPath(c)) && existsAfter(tallyPath(c));
    }

    // How many times `value` is in a list (no loop needed).
    function countIn(values, value) {
      return values.size() - values.removeAll([value]).size();
    }

    // Merge i: the reading it was merged into starts with one vote per
    // member who nominated it (its own nominator and every merged one).
    function startsAheadAt(v, targets, i) {
      return i >= targets.size() || v[targets[i]] == 1 + countIn(targets, targets[i]);
    }

    // Every option at zero except merged readings, at their head start.
    // Every merge target is checked, and only as many options as there are
    // distinct targets are above zero, so no other option can be.
    function isOpeningCount(v, options, merged) {
      let targets = merged.values();
      return v is map && v.keys().hasAll(options) && v.keys().hasOnly(options)
        && v.values().removeAll([0]).size() == targets.toSet().size()
        && startsAheadAt(v, targets, 0) && startsAheadAt(v, targets, 1)
        && startsAheadAt(v, targets, 2) && startsAheadAt(v, targets, 3)
        && startsAheadAt(v, targets, 4) && startsAheadAt(v, targets, 5)
        && startsAheadAt(v, targets, 6) && startsAheadAt(v, targets, 7);
    }

    // Only together with the cycle opening its vote. Head-start votes are
    // first choices too.
    function isNewTally(c) {
      let cycle = getAfter(cyclePath(c)).data;
      let tally = request.resource.data;
      return get(cyclePath(c)).data.status == 'nominating'
        && cycle.status == 'voting'
        && hasExactly(tally, ['votes', 'firsts'])
        && tally.firsts == tally.votes
        && isOpeningCount(tally.votes, cycle.options, cycle.merged);
    }

    // ---------------------------------------------------- the review
    // Once everyone answered, the list opens and is checked for readings
    // nominated twice. Stored as { ids, groups }: every flagged id (null
    // while the check runs) and the groups, with why, for the organizer.

    // Only once everyone answered, and nobody let go is still choosing again:
    // it reveals the list (even to the organizer) and closes nominations.
    function startsReview(before, after) {
      return before.status == 'nominating' && before.review == null
        && before.nominationIds.size() > 0 && before.letGo.size() == 0
        && everyone(before.responses)
        && changesOnly(['review'])
        && after.review == { 'ids': null, 'groups': [] };
    }

    // A conflict group: two or three flagged readings, and why.
    function isGroup(g, ids) {
      return g is map && hasExactly(g, ['ids', 'reason'])
        && g.ids is list && g.ids.size() >= 2 && g.ids.size() <= 3
        && ids.hasAll(g.ids)
        && isText(g.reason, 0, 200);
    }

    function idsOf(groups, i) {
      return i < groups.size() ? groups[i].ids : [];
    }

    // Every flagged id is in exactly one group, at most three groups.
    function isReviewData(review, nominationIds) {
      let ids = review.ids;
      let groups = review.groups;
      return review is map && hasExactly(review, ['ids', 'groups'])
        && ids is list && ids.hasOnly(nominationIds)
        && ids.toSet().size() == ids.size()
        && groups is list && groups.size() <= 3
        && (groups.size() < 1 || isGroup(groups[0], ids))
        && (groups.size() < 2 || isGroup(groups[1], ids))
        && (groups.size() < 3 || isGroup(groups[2], ids))
        && ids.size() == idsOf(groups, 0).size() + idsOf(groups, 1).size()
          + idsOf(groups, 2).size()
        && ids.toSet() == idsOf(groups, 0).toSet().union(idsOf(groups, 1).toSet())
          .union(idsOf(groups, 2).toSet());
    }

    // What the check found, recorded once. Anyone may record that it found
    // nothing; only the organizer may record flags (they reveal nominators to
    // the organizer alone). Readings already merged are not checked again.
    // Every reading flagged in the round is kept in `flagged`: no more than
    // one pair, or half the list, over the whole round, so a check that flags
    // much (or again and again) is not believed.
    function recordsReview(before, after) {
      return before.status == 'nominating' && before.review != null
        && before.review.ids == null
        && changesOnly(['review', 'flagged'])
        && isReviewData(after.review, before.nominationIds)
        && !after.review.ids.hasAny(before.merged.keys())
        && (after.review.ids.size() == 0 || isAdmin())
        && after.flagged == before.flagged.concat(after.review.ids.removeAll(before.flagged))
        && (after.flagged.size() <= 2 || after.flagged.size() * 2 <= before.nominationIds.size());
    }

    function isClearReview(cycle) {
      return cycle.review != null && cycle.review.ids == [];
    }

    // Merges point from a nomination to another that stays on the ballot.
    function isMerge(merged, nominationIds) {
      return merged is map && merged.size() <= 8
        && merged.keys().hasOnly(nominationIds) && merged.values().hasOnly(nominationIds)
        && !merged.keys().hasAny(merged.values());
    }

    // Merging one flagged group (r): all its readings but one now point at
    // the one kept on the ballot; no other merge changes.
    function mergesGroup(b, a, r) {
      let added = a.diff(b);
      let kept = a.get(r[0], r[0]);
      return r.size() >= 2 && r.size() <= 3
        && added.changedKeys().size() == 0 && added.removedKeys().size() == 0
        && added.addedKeys().size() == r.size() - 1
        && added.addedKeys().difference(r.toSet()).size() == 0
        && kept in r && !(kept in a)
        && a.get(r[1], r[1]) == kept
        && (r.size() < 3 || a.get(r[2], r[2]) == kept);
    }

    // The organizer, once the check is recorded: dismiss flagged groups, or
    // merge one into a single reading. Nothing new can be flagged.
    function editsReview(before, after) {
      return before.status == 'nominating' && before.review != null
        && before.review.ids != null
        && changesOnly(['review', 'merged'])
        && isReviewData(after.review, before.nominationIds)
        && after.review.ids.hasOnly(before.review.ids)
        && before.review.groups.hasAll(after.review.groups)
        && (after.merged == before.merged
          || (isMerge(after.merged, before.nominationIds)
            && mergesGroup(before.merged, after.merged,
              before.review.ids.removeAll(after.review.ids))));
    }

    // The organizer lets flagged readings go, so their nominators can
    // nominate again: the nominations and their title records are deleted,
    // they leave the list (which keeps its order), the count drops and the
    // review starts over once everyone answered again. Their answers stay;
    // only their members can replace them. Merged readings stay.
    function reopensNominations(c, before, after) {
      let removed = before.nominationIds.removeAll(after.nominationIds);
      return before.status == 'nominating' && before.review != null
        && before.review.ids != null
        && changesOnly(['review', 'responses', 'nominationIds', 'letGo', 'letGoAt'])
        && after.review == null
        && after.letGo == before.letGo.concat(removed)
        && after.letGoAt == request.time
        && after.nominationIds == before.nominationIds.removeAll(removed)
        && removed.size() >= 1 && removed.size() <= 3
        && removed.hasOnly(before.review.ids)
        && !removed.hasAny(before.merged.keys()) && !removed.hasAny(before.merged.values())
        && after.responses == before.responses - removed.size()
        && !existsAfter(nominationPath(c, removed[0]))
        && (removed.size() < 2 || !existsAfter(nominationPath(c, removed[1])))
        && (removed.size() < 3 || !existsAfter(nominationPath(c, removed[2])));
    }

    // A flagged reading, while its review is open.
    function isFlagged(c, n) {
      let cycle = get(cyclePath(c)).data;
      return cycle.status == 'nominating' && cycle.review != null
        && cycle.review.ids != null && n in cycle.review.ids;
    }

    // In the batch that reopens nominations, a reading leaving the list.
    function isUnlocking(c, n) {
      return isFlagged(c, n) && isReopening(c)
        && !(n in getAfter(cyclePath(c)).data.nominationIds);
    }

    function isReopening(c) {
      return get(cyclePath(c)).data.review != null
        && getAfter(cyclePath(c)).data.review == null
        && getAfter(cyclePath(c)).data.status == 'nominating';
    }

    // The title record of a nomination leaving the list in this batch.
    function isLetGoTitle(c, key) {
      let removed = get(cyclePath(c)).data.nominationIds
        .removeAll(getAfter(cyclePath(c)).data.nominationIds);
      return (removed.size() > 0 && get(nominationPath(c, removed[0])).data.titleKey == key)
        || (removed.size() > 1 && get(nominationPath(c, removed[1])).data.titleKey == key)
        || (removed.size() > 2 && get(nominationPath(c, removed[2])).data.titleKey == key);
    }

    function closesVoting(before, after) {
      return before.status == 'voting' && after.status == 'tallying'
        && changesOnly(['status', 'votingClosedAt'])
        && after.votingClosedAt == request.time;
    }

    // How many options have exactly `value` in a tally map (no loop needed).
    function countOf(counts, value) {
      return counts.size() - counts.values().removeAll([value]).size();
    }

    // Every option is behind the winner w, except the ones listed in d, which
    // tie with it. Votes count first, then first choices: as one number,
    // votes × M + first choices (one first choice per member keeps them
    // apart). Each slot is the same check for one option, written out in
    // full, since function arguments count as expressions too.
    function isTop(o, r, w, d) {
      let n = o.size();
      let v = r.votes;
      let f = r.firsts;
      let M = 1000000;
      let top = v[w] * M + f[w];
      return (n < 1 || (o[0] in d ? v[o[0]] * M + f[o[0]] == top : v[o[0]] * M + f[o[0]] < top))
        && (n < 2 || (o[1] in d ? v[o[1]] * M + f[o[1]] == top : v[o[1]] * M + f[o[1]] < top))
        && (n < 3 || (o[2] in d ? v[o[2]] * M + f[o[2]] == top : v[o[2]] * M + f[o[2]] < top))
        && (n < 4 || (o[3] in d ? v[o[3]] * M + f[o[3]] == top : v[o[3]] * M + f[o[3]] < top))
        && (n < 5 || (o[4] in d ? v[o[4]] * M + f[o[4]] == top : v[o[4]] * M + f[o[4]] < top))
        && (n < 6 || (o[5] in d ? v[o[5]] * M + f[o[5]] == top : v[o[5]] * M + f[o[5]] < top))
        && (n < 7 || (o[6] in d ? v[o[6]] * M + f[o[6]] == top : v[o[6]] * M + f[o[6]] < top))
        && (n < 8 || (o[7] in d ? v[o[7]] * M + f[o[7]] == top : v[o[7]] * M + f[o[7]] < top))
        && (n < 9 || (o[8] in d ? v[o[8]] * M + f[o[8]] == top : v[o[8]] * M + f[o[8]] < top))
        && (n < 10 || (o[9] in d ? v[o[9]] * M + f[o[9]] == top : v[o[9]] * M + f[o[9]] < top))
        && (n < 11 || (o[10] in d ? v[o[10]] * M + f[o[10]] == top : v[o[10]] * M + f[o[10]] < top))
        && (n < 12 || (o[11] in d ? v[o[11]] * M + f[o[11]] == top : v[o[11]] * M + f[o[11]] < top))
        && (n < 13 || (o[12] in d ? v[o[12]] * M + f[o[12]] == top : v[o[12]] * M + f[o[12]] < top))
        && (n < 14 || (o[13] in d ? v[o[13]] * M + f[o[13]] == top : v[o[13]] * M + f[o[13]] < top))
        && (n < 15 || (o[14] in d ? v[o[14]] * M + f[o[14]] == top : v[o[14]] * M + f[o[14]] < top))
        && (n < 16 || (o[15] in d ? v[o[15]] * M + f[o[15]] == top : v[o[15]] * M + f[o[15]] < top));
    }

    // The pseudo-random number a closing time gives (0 to 32767): a linear
    // congruential generator with the C library's constants, started from the
    // milliseconds, three steps, high 15 bits. src/domain/draw.ts runs the
    // same one; products stay within 64-bit integers.
    function drawNumber(closedAt) {
      let m = 2147483648;
      let s0 = closedAt.toMillis() % m;
      let s1 = (1103515245 * s0 + 12345) % m;
      let s2 = (1103515245 * s1 + 12345) % m;
      let s3 = (1103515245 * s2 + 12345) % m;
      return s3 / 65536;
    }

    // The draw list holds exactly the books tied with the winner, in the
    // ballot's order (fixed when voting opened); the winner is the one the
    // closing time's pseudo-random number lands on. Nobody picks it.
    function isFairDraw(o, r, w, d, closedAt) {
      return d is list && d.size() >= 2
        // Ballot options, each once, in the ballot's order: no loop needed.
        && o.removeAll(o.removeAll(d)) == d
        && d[drawNumber(closedAt) % d.size()] == w
        && isTop(o, r, w, d);
    }

    // The method must be the step that actually decided: a clear leader on
    // votes cannot be labeled a first-choice or a draw win, and so on.
    function isEarnedWin(o, r, winner, closedAt) {
      let w = winner.nominationId;
      let m = winner.method;
      let d = winner.drawnFrom;
      let tiedOnVotes = countOf(r.votes, r.votes[w]);
      return (m == 'unopposed' && d == [] && o.size() == 1)
        || (m == 'votes' && d == [] && o.size() > 1 && tiedOnVotes == 1 && isTop(o, r, w, [w]))
        || (m == 'first-choices' && d == [] && tiedOnVotes > 1 && isTop(o, r, w, [w]))
        || (m == 'draw' && isFairDraw(o, r, w, d, closedAt));
    }

    // Whether the round before is still being read (or waiting to be): the
    // winner then waits as the upcoming reading (src/domain/cycle.ts decides
    // the same way). An upcoming reading is started by the organizer.
    function waitsForPrevious(before) {
      let previous = cyclePath(cycleIdFor(before.number - 1));
      return exists(previous) && get(previous).data.status in ['reading', 'upcoming'];
    }

    // Results must be the tally itself; the winner must follow the rule.
    function declaresWinner(c, before, after) {
      let winner = after.winner;
      return before.status == 'tallying'
        && changesOnly(['status', 'winner', 'results', 'readingStartedAt'])
        && ((after.status == 'reading' && after.readingStartedAt == request.time
            && !waitsForPrevious(before))
          || (after.status == 'upcoming' && after.readingStartedAt == null
            && waitsForPrevious(before)))
        && after.results == get(tallyPath(c)).data
        && winner is map
        && hasExactly(winner, ['nominationId', 'book', 'method', 'decidedAt', 'drawnFrom'])
        && winner.decidedAt == request.time
        && winner.nominationId in before.options
        && winner.book == get(nominationPath(c, winner.nominationId)).data.book
        && isEarnedWin(before.options, after.results, winner, before.votingClosedAt);
    }

    // A round nobody nominated in (everyone passed, or the deadline is over)
    // can only end: there is nothing to vote on. The organizer opens the next.
    // Members let go get their three days to nominate again first.
    function endsEmptyRound(before, after) {
      return before.status == 'nominating' && after.status == 'finished'
        && before.nominationIds.size() == 0
        && (before.letGo.size() == 0 || request.time > before.letGoAt + duration.value(3, 'd'))
        && (everyone(before.responses)
          || (before.nominationDeadline != null && request.time > before.nominationDeadline))
        && changesOnly(['status', 'finishedAt'])
        && after.finishedAt == request.time;
    }

    function startsReading(before, after) {
      return before.status == 'upcoming' && after.status == 'reading'
        && changesOnly(['status', 'readingStartedAt'])
        && after.readingStartedAt == request.time;
    }

    function finishesReading(before, after) {
      return before.status == 'reading' && after.status == 'finished'
        && changesOnly(['status', 'finishedAt'])
        && after.finishedAt == request.time;
    }

    // The organizer may also edit deadlines, open or close the vote early and
    // move the chosen reading along. Declaring the winner is a flow step.
    function isValidTransition(c, before, after) {
      return editsDeadline(before, after)
        || startsReview(before, after)
        || editsReview(before, after)
        || reopensNominations(c, before, after)
        || endsEmptyRound(before, after)
        || startsVoting(c, before, after)
        || closesVoting(before, after)
        || startsReading(before, after)
        || finishesReading(before, after);
    }
  }
}
