rules_version = '2';

// Security model
// --------------
// * Only verified emails present in /allowlist can read or write anything.
// * Member data is bound to request.auth.uid and is create-only: answers,
//   nominations and ballot receipts can never be edited or deleted, so nobody
//   (including the admin) can change what another member sent.
// * Votes are anonymous: a ballot is one batch that creates an empty receipt
//   (who voted), bumps the cycle's ballot count and adds +1 to the chosen
//   books in a tally (every choice to `votes`, the first one also to
//   `firsts`) that nobody can read until voting closes. Nothing links a
//   member to their choices.
// * Admin writes follow a state machine and cannot touch the tally; the
//   declared winner must follow the club's rule (most votes, then most first
//   choices, then a draw among the books still tied). A draw is fixed by the
//   time voting closed, so these rules recompute it.
// * The cycle moves on by itself: any member may take the next step once
//   everyone (settings/club.members) has answered, voted or finished the
//   book. The organizer may take a step at any time.
// * Everything not explicitly allowed is denied.
//
// Limits shared with src/domain: book fields (book.ts), two choices per
// ballot and 20 options (voting.ts). Rules have no loops, so list checks are
// unrolled, each slot guarded by the list's size.
//
// Firestore evaluates at most 1000 expressions per request, shared by every
// document of a batch. Hence the order below: cheap status checks first, and
// list checks that only do real work for the options that exist.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity

    function email() {
      return request.auth.token.email.lower();
    }

    function allowlistEntry() {
      return /databases/$(database)/documents/allowlist/$(email());
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMember() {
      return isVerified() && exists(allowlistEntry());
    }

    function isAdmin() {
      return isMember() && get(allowlistEntry()).data.get('admin', false) == true;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    // ------------------------------------------------------------------ paths

    function cyclePath(c) {
      return /databases/$(database)/documents/cycles/$(c);
    }

    function nominationPath(c, n) {
      return /databases/$(database)/documents/cycles/$(c)/nominations/$(n);
    }

    function answerPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/answers/$(request.auth.uid);
    }

    function tallyPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/tally/counts;
    }

    function receiptPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/receipts/$(request.auth.uid);
    }

    function readerPath(c) {
      return /databases/$(database)/documents/cycles/$(c)/readers/$(request.auth.uid);
    }

    function settingsPath() {
      return /databases/$(database)/documents/settings/club;
    }

    // Cycles are named by number, so a round can only ever be opened once.
    function cycleIdFor(number) {
      return 'ciclo-' + string(number);
    }

    // How many members "everyone" is. Missing settings stop the automatic
    // flow (the read fails) until the organizer sets them.
    function everyone(count) {
      return count >= get(settingsPath()).data.members;
    }

    // ------------------------------------------------------------- validation

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Links are stored URL-encoded (printable ASCII, no spaces).
    function isLink(value) {
      return value is string && value.size() <= 1000 && value.matches('https://[!-~]+');
    }

    function isUploadedCover(value) {
      return value is string && value.size() <= 200000
        && value.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+=*');
    }

    function isOptionalTime(value) {
      return value == null || value is timestamp;
    }

    // Any kind of reading, described in free text: only sizes and link
    // formats are checked.
    function isSynopsis(book) {
      return (book.synopsis == null && book.synopsisSource == null)
        || (isText(book.synopsis, 1, 2000)
          && (book.synopsisSource == null
            || book.synopsisSource in ['wikipedia', 'open-library', 'google-books', 'anilist']));
    }

    function isBook(book) {
      return book is map
        && hasExactly(book, ['title', 'synopsis', 'synopsisSource', 'synopsisUrl', 'coverUrl'])
        && isText(book.title, 1, 200)
        && isSynopsis(book)
        && (book.synopsisUrl == null || isLink(book.synopsisUrl))
        && (book.coverUrl == null || isLink(book.coverUrl) || isUploadedCover(book.coverUrl));
    }

    function isBeforeDeadline(deadline) {
      return deadline == null || request.time < deadline;
    }

    // -------------------------------------------------------------- allowlist
    // Document id = lowercase email. Members can only check their own entry;
    // only the admin can list or change entries, never their own.

    match /allowlist/{address} {
      allow get: if isVerified() && address == email();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && address != email()
        && address == address.lower()
        && address.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.keys().hasOnly(['admin'])
        && request.resource.data.get('admin', false) is bool;
      allow delete: if isAdmin() && address != email();
    }

    // ---------------------------------------------------------------- members
    // Public profile inside the club: name and photo only, never the email.

    match /members/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && isSelf(uid)
        && hasExactly(request.resource.data, ['name', 'photoURL'])
        && isText(request.resource.data.name, 1, 80)
        && (request.resource.data.photoURL == null || isLink(request.resource.data.photoURL));
    }

    // --------------------------------------------------------------- settings
    // Only the member count, kept by the organizer in step with the allowlist.

    match /settings/{docId} {
      allow read: if isMember() && docId == 'club';
      allow create, update: if isAdmin() && docId == 'club'
        && hasExactly(request.resource.data, ['members'])
        && request.resource.data.members is int
        && request.resource.data.members >= 1
        && request.resource.data.members <= 100;
    }

    // ----------------------------------------------------------------- cycles

    match /cycles/{cycleId} {
      allow read: if isMember();
      allow create: if (isAdmin() && isNewCycle(cycleId, request.resource.data))
        || (isMember() && isNextRound(cycleId, request.resource.data));
      allow update: if isMember()
        && (countsOwnPart(cycleId, resource.data, request.resource.data)
          || isFlowStep(cycleId, resource.data, request.resource.data)
          || (isAdmin() && isValidTransition(cycleId, resource.data, request.resource.data)));
      // A cycle can be dropped only before any vote exists.
      allow delete: if isAdmin() && resource.data.status == 'nominating';

      // ---------------------------------------------------------- answers
      // One per member and final: either a nomination id or null (passed).

      match /answers/{uid} {
        allow get: if isMember() && isSelf(uid);
        allow create: if isMember() && isSelf(uid) && isNewAnswer(cycleId);
      }

      // ------------------------------------------------------ nominations
      // Never stores who nominated. Created only together with the
      // nominator's own answer pointing at it.

      match /nominations/{nominationId} {
        allow read: if isMember();
        allow create: if isMember() && isNewNomination(cycleId, nominationId);
      }

      // ---------------------------------------------------------- ballots
      // A receipt says only *that* a member voted; the tally says only
      // *what* was voted.

      match /receipts/{uid} {
        allow get: if isMember() && isSelf(uid);
        allow create: if isMember() && isSelf(uid) && isNewReceipt(cycleId);
      }

      match /tally/{docId} {
        allow get: if isMember() && docId == 'counts'
          && !(get(cyclePath(cycleId)).data.status in ['nominating', 'voting']);
        allow create: if isMember() && docId == 'counts' && isNewTally(cycleId);
        allow update: if isMember() && docId == 'counts' && isValidVote(cycleId);
      }

      // ---------------------------------------------------------- readers
      // "Acabei de ler!": the mark says *that* a member finished; the cycle
      // only counts how many.

      match /readers/{uid} {
        allow get: if isMember() && isSelf(uid);
        allow create: if isMember() && isSelf(uid) && isNewReaderMark(cycleId);
      }
    }

    // ------------------------------------------------------ nomination writes
    // Batch: answers/{uid} + cycles/{id}.responses (+1) [+ nominations/{id}]

    function acceptsNominations(c) {
      let cycle = get(cyclePath(c)).data;
      return cycle.status == 'nominating' && isBeforeDeadline(cycle.nominationDeadline);
    }

    function isAnsweringNow(c) {
      return !exists(answerPath(c)) && existsAfter(answerPath(c));
    }

    // A member's own answer, ballot or "Acabei de ler!", counted on the cycle.
    function countsOwnPart(c, before, after) {
      return (before.status == 'nominating' && countsOwnAnswer(c, before, after))
        || (before.status == 'voting' && countsOwnBallot(c, before, after))
        || (before.status == 'reading' && countsOwnFinish(c, before, after));
    }

    function countsOwnAnswer(c, before, after) {
      return changesOnly(['responses', 'nominationIds'])
        && after.responses == before.responses + 1
        && isAnsweringNow(c)
        && listsOwnNomination(c, before.nominationIds, after.nominationIds);
    }

    // A nomination also joins the cycle's list, in arrival order, while the
    // ballot has room for it.
    function listsOwnNomination(c, before, after) {
      let nominated = getAfter(answerPath(c)).data.nominationId;
      return (nominated == null && after == before)
        || (nominated != null && before.size() < 20 && after == before.concat([nominated]));
    }

    function isNewAnswer(c) {
      let answer = request.resource.data;
      return acceptsNominations(c)
        && hasExactly(answer, ['nominationId'])
        && getAfter(cyclePath(c)).data.responses == get(cyclePath(c)).data.responses + 1
        && (answer.nominationId == null
          || (answer.nominationId is string
            && !exists(nominationPath(c, answer.nominationId))
            && existsAfter(nominationPath(c, answer.nominationId))));
    }

    function isNewNomination(c, n) {
      return acceptsNominations(c)
        && hasExactly(request.resource.data, ['book'])
        && isBook(request.resource.data.book)
        && isAnsweringNow(c)
        && getAfter(answerPath(c)).data.nominationId == n;
    }

    // ------------------------------------------------------------ ballot writes
    // Batch: receipts/{uid} (empty) + cycles/{id}.ballots (+1) + tally

    function isVotingNow(c) {
      return !exists(receiptPath(c)) && existsAfter(receiptPath(c));
    }

    function isNewReceipt(c) {
      return request.resource.data.keys().size() == 0
        && getAfter(cyclePath(c)).data.ballots == get(cyclePath(c)).data.ballots + 1;
    }

    function countsOwnBallot(c, before, after) {
      return isBeforeDeadline(before.votingDeadline)
        && changesOnly(['ballots'])
        && after.ballots == before.ballots + 1
        && isVotingNow(c)
        && getAfter(tallyPath(c)).data != get(tallyPath(c)).data;
    }

    // The member's own nomination, or '' (never a valid option id).
    function ownNomination(c) {
      return exists(answerPath(c)) ? get(answerPath(c)).data.nominationId : '';
    }

    // Two choices, or fewer when there are not enough eligible books.
    function requiredChoices(options, own) {
      let eligible = options.size() - (own in options ? 1 : 0);
      return eligible < 2 ? eligible : 2;
    }

    // Option i, if chosen, gains one vote, and its first-choice count either
    // stays or gains one. Options not chosen are left as they were (the
    // diff checks below).
    function addsOneAt(o, chosen, i) {
      let x = o[i];
      let before = resource.data;
      let after = request.resource.data;
      return !(x in chosen)
        || (after.votes[x] == before.votes[x] + 1
          && (after.firsts[x] == before.firsts[x] || after.firsts[x] == before.firsts[x] + 1));
    }

    function addsOneEach(o, s) {
      let n = o.size();
      return (n < 1 || addsOneAt(o, s, 0)) && (n < 2 || addsOneAt(o, s, 1))
        && (n < 3 || addsOneAt(o, s, 2)) && (n < 4 || addsOneAt(o, s, 3))
        && (n < 5 || addsOneAt(o, s, 4)) && (n < 6 || addsOneAt(o, s, 5))
        && (n < 7 || addsOneAt(o, s, 6)) && (n < 8 || addsOneAt(o, s, 7))
        && (n < 9 || addsOneAt(o, s, 8)) && (n < 10 || addsOneAt(o, s, 9))
        && (n < 11 || addsOneAt(o, s, 10)) && (n < 12 || addsOneAt(o, s, 11))
        && (n < 13 || addsOneAt(o, s, 12)) && (n < 14 || addsOneAt(o, s, 13))
        && (n < 15 || addsOneAt(o, s, 14)) && (n < 16 || addsOneAt(o, s, 15))
        && (n < 17 || addsOneAt(o, s, 16)) && (n < 18 || addsOneAt(o, s, 17))
        && (n < 19 || addsOneAt(o, s, 18)) && (n < 20 || addsOneAt(o, s, 19));
    }

    // The tally keeps exactly the ballot's options (it is created with them
    // and never gains or loses a key), so the changed keys are options.
    function isValidVote(c) {
      let cycle = get(cyclePath(c)).data;
      let votes = request.resource.data.votes.diff(resource.data.votes);
      let firsts = request.resource.data.firsts.diff(resource.data.firsts);
      let own = ownNomination(c);
      return cycle.status == 'voting'
        && hasExactly(request.resource.data, ['votes', 'firsts'])
        && votes.addedKeys().size() == 0 && votes.removedKeys().size() == 0
        && firsts.addedKeys().size() == 0 && firsts.removedKeys().size() == 0
        && votes.changedKeys().size() == requiredChoices(cycle.options, own)
        && !(own in votes.changedKeys())
        // Exactly one first choice, and it is one of the books voted for.
        && firsts.changedKeys().size() == 1
        && firsts.changedKeys().difference(votes.changedKeys()).size() == 0
        && addsOneEach(cycle.options, votes.changedKeys())
        && isVotingNow(c);
    }

    // -------------------------------------------------------- reader writes
    // Batch: readers/{uid} (empty) + cycles/{id}.finishedReaders (+1)

    function isFinishingNow(c) {
      return !exists(readerPath(c)) && existsAfter(readerPath(c));
    }

    function isNewReaderMark(c) {
      return request.resource.data.keys().size() == 0
        && get(cyclePath(c)).data.status == 'reading'
        && getAfter(cyclePath(c)).data.finishedReaders
          == get(cyclePath(c)).data.finishedReaders + 1;
    }

    function countsOwnFinish(c, before, after) {
      return changesOnly(['finishedReaders'])
        && after.finishedReaders == before.finishedReaders + 1
        && isFinishingNow(c);
    }

    // ------------------------------------------------------------- flow steps
    // Any member, once everyone has done their part. Declaring the winner is
    // fully checked, so anyone may do it as soon as the vote is closed.

    function isFlowStep(c, before, after) {
      return (before.status == 'nominating' && after.options == before.nominationIds
          && everyone(before.responses) && startsVoting(c, before, after))
        || (before.status == 'voting'
          && (before.options.size() == 1 || everyone(before.ballots))
          && closesVoting(before, after))
        || (before.status == 'tallying' && declaresWinner(c, before, after))
        || (before.status == 'reading' && finishesForEveryone(before, after));
    }

    // Ending the book always opens the next round, in the same batch.
    function finishesForEveryone(before, after) {
      let next = cyclePath(cycleIdFor(before.number + 1));
      return finishesReading(before, after)
        && everyone(before.finishedReaders)
        && !exists(next) && existsAfter(next);
    }

    // The next round, created together with ending the book before it.
    function isNextRound(id, cycle) {
      let previous = cyclePath(cycleIdFor(cycle.number - 1));
      return isNewCycle(id, cycle)
        && cycle.nominationDeadline == null
        && get(previous).data.status == 'reading'
        && getAfter(previous).data.status == 'finished';
    }

    // ------------------------------------------------------------- admin: cycles

    function isNewCycle(id, cycle) {
      return hasExactly(cycle, ['number', 'status', 'responses', 'nominationIds',
                                'nominationDeadline', 'votingDeadline', 'createdAt',
                                'options', 'ballots', 'votingOpenedAt', 'votingClosedAt',
                                'results', 'winner', 'readingStartedAt', 'finishedReaders',
                                'finishedAt'])
        && cycle.number is int && cycle.number >= 1
        && id == cycleIdFor(cycle.number)
        && cycle.status == 'nominating' && cycle.responses == 0
        && cycle.nominationIds == [] && cycle.finishedReaders == 0
        && isOptionalTime(cycle.nominationDeadline) && cycle.votingDeadline == null
        && cycle.createdAt == request.time
        && cycle.options == [] && cycle.ballots == 0
        && cycle.votingOpenedAt == null && cycle.votingClosedAt == null
        && cycle.results == null && cycle.winner == null
        && cycle.readingStartedAt == null && cycle.finishedAt == null;
    }

    function editsDeadline(before, after) {
      return (before.status == 'nominating' && changesOnly(['nominationDeadline'])
          && isOptionalTime(after.nominationDeadline))
        || (before.status == 'voting' && changesOnly(['votingDeadline'])
          && isOptionalTime(after.votingDeadline));
    }

    function hasDistinctOptions(options) {
      return options is list && options.size() >= 1 && options.size() <= 20
        && options.toSet().size() == options.size();
    }

    // Batch: cycles/{id} (to voting, with the ballot's options) + tally (all zero)
    function startsVoting(c, before, after) {
      return before.status == 'nominating' && after.status == 'voting'
        && changesOnly(['status', 'options', 'ballots', 'votingOpenedAt', 'votingDeadline'])
        && hasDistinctOptions(after.options)
        && after.options.size() <= before.responses
        && after.ballots == 0
        && after.votingOpenedAt == request.time
        && isOptionalTime(after.votingDeadline)
        && !exists(tallyPath(c)) && existsAfter(tallyPath(c));
    }

    function isZeroed(tally, options) {
      return tally is map
        && tally.keys().hasAll(options) && tally.keys().hasOnly(options)
        && tally.values().hasOnly([0]);
    }

    // Only together with the cycle opening its vote.
    function isNewTally(c) {
      let options = getAfter(cyclePath(c)).data.options;
      let tally = request.resource.data;
      return get(cyclePath(c)).data.status == 'nominating'
        && getAfter(cyclePath(c)).data.status == 'voting'
        && hasExactly(tally, ['votes', 'firsts'])
        && isZeroed(tally.votes, options)
        && isZeroed(tally.firsts, options);
    }

    function closesVoting(before, after) {
      return before.status == 'voting' && after.status == 'tallying'
        && changesOnly(['status', 'votingClosedAt'])
        && after.votingClosedAt == request.time;
    }

    // How many options have exactly `value` in a tally map (no loop needed).
    function countOf(counts, value) {
      return counts.size() - counts.values().removeAll([value]).size();
    }

    // Every option is behind the winner w, except the ones listed in d, which
    // tie with it. Votes count first, then first choices: as one number,
    // votes × M + first choices (one first choice per member keeps them
    // apart). Each slot is the same check for one option, written out in
    // full, since function arguments count as expressions too.
    function isTop(o, r, w, d) {
      let n = o.size();
      let v = r.votes;
      let f = r.firsts;
      let M = 1000000;
      let top = v[w] * M + f[w];
      return (n < 1 || (o[0] in d ? v[o[0]] * M + f[o[0]] == top : v[o[0]] * M + f[o[0]] < top))
        && (n < 2 || (o[1] in d ? v[o[1]] * M + f[o[1]] == top : v[o[1]] * M + f[o[1]] < top))
        && (n < 3 || (o[2] in d ? v[o[2]] * M + f[o[2]] == top : v[o[2]] * M + f[o[2]] < top))
        && (n < 4 || (o[3] in d ? v[o[3]] * M + f[o[3]] == top : v[o[3]] * M + f[o[3]] < top))
        && (n < 5 || (o[4] in d ? v[o[4]] * M + f[o[4]] == top : v[o[4]] * M + f[o[4]] < top))
        && (n < 6 || (o[5] in d ? v[o[5]] * M + f[o[5]] == top : v[o[5]] * M + f[o[5]] < top))
        && (n < 7 || (o[6] in d ? v[o[6]] * M + f[o[6]] == top : v[o[6]] * M + f[o[6]] < top))
        && (n < 8 || (o[7] in d ? v[o[7]] * M + f[o[7]] == top : v[o[7]] * M + f[o[7]] < top))
        && (n < 9 || (o[8] in d ? v[o[8]] * M + f[o[8]] == top : v[o[8]] * M + f[o[8]] < top))
        && (n < 10 || (o[9] in d ? v[o[9]] * M + f[o[9]] == top : v[o[9]] * M + f[o[9]] < top))
        && (n < 11 || (o[10] in d ? v[o[10]] * M + f[o[10]] == top : v[o[10]] * M + f[o[10]] < top))
        && (n < 12 || (o[11] in d ? v[o[11]] * M + f[o[11]] == top : v[o[11]] * M + f[o[11]] < top))
        && (n < 13 || (o[12] in d ? v[o[12]] * M + f[o[12]] == top : v[o[12]] * M + f[o[12]] < top))
        && (n < 14 || (o[13] in d ? v[o[13]] * M + f[o[13]] == top : v[o[13]] * M + f[o[13]] < top))
        && (n < 15 || (o[14] in d ? v[o[14]] * M + f[o[14]] == top : v[o[14]] * M + f[o[14]] < top))
        && (n < 16 || (o[15] in d ? v[o[15]] * M + f[o[15]] == top : v[o[15]] * M + f[o[15]] < top))
        && (n < 17 || (o[16] in d ? v[o[16]] * M + f[o[16]] == top : v[o[16]] * M + f[o[16]] < top))
        && (n < 18 || (o[17] in d ? v[o[17]] * M + f[o[17]] == top : v[o[17]] * M + f[o[17]] < top))
        && (n < 19 || (o[18] in d ? v[o[18]] * M + f[o[18]] == top : v[o[18]] * M + f[o[18]] < top))
        && (n < 20 || (o[19] in d ? v[o[19]] * M + f[o[19]] == top : v[o[19]] * M + f[o[19]] < top));
    }

    // The draw list holds exactly the books tied with the winner, in the
    // ballot's order (fixed when voting opened); the winner is the one at the
    // closing time's milliseconds modulo their count. Nobody picks it.
    function isFairDraw(o, r, w, d, closedAt) {
      return d is list && d.size() >= 2
        // Ballot options, each once, in the ballot's order: no loop needed.
        && o.removeAll(o.removeAll(d)) == d
        && d[closedAt.toMillis() % d.size()] == w
        && isTop(o, r, w, d);
    }

    // The method must be the step that actually decided: a clear leader on
    // votes cannot be labeled a first-choice or a draw win, and so on.
    function isEarnedWin(o, r, winner, closedAt) {
      let w = winner.nominationId;
      let m = winner.method;
      let d = winner.drawnFrom;
      let tiedOnVotes = countOf(r.votes, r.votes[w]);
      return (m == 'unopposed' && d == [] && o.size() == 1)
        || (m == 'votes' && d == [] && o.size() > 1 && tiedOnVotes == 1 && isTop(o, r, w, [w]))
        || (m == 'first-choices' && d == [] && tiedOnVotes > 1 && isTop(o, r, w, [w]))
        || (m == 'draw' && isFairDraw(o, r, w, d, closedAt));
    }

    // Results must be the tally itself; the winner must follow the rule.
    function declaresWinner(c, before, after) {
      let winner = after.winner;
      return before.status == 'tallying'
        && changesOnly(['status', 'winner', 'results', 'readingStartedAt'])
        && ((after.status == 'reading' && after.readingStartedAt == request.time)
          || (after.status == 'upcoming' && after.readingStartedAt == null))
        && after.results == get(tallyPath(c)).data
        && winner is map
        && hasExactly(winner, ['nominationId', 'book', 'method', 'decidedAt', 'drawnFrom'])
        && winner.decidedAt == request.time
        && winner.nominationId in before.options
        && winner.book == get(nominationPath(c, winner.nominationId)).data.book
        && isEarnedWin(before.options, after.results, winner, before.votingClosedAt);
    }

    function startsReading(before, after) {
      return before.status == 'upcoming' && after.status == 'reading'
        && changesOnly(['status', 'readingStartedAt'])
        && after.readingStartedAt == request.time;
    }

    function finishesReading(before, after) {
      return before.status == 'reading' && after.status == 'finished'
        && changesOnly(['status', 'finishedAt'])
        && after.finishedAt == request.time;
    }

    // The organizer may also edit deadlines, open or close the vote early and
    // move the chosen reading along. Declaring the winner is a flow step.
    function isValidTransition(c, before, after) {
      return editsDeadline(before, after)
        || startsVoting(c, before, after)
        || closesVoting(before, after)
        || startsReading(before, after)
        || finishesReading(before, after);
    }
  }
}
